# =============================================================================
#  UI · paleta y componentes
# =============================================================================

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    C_RESET=$'\033[0m'
    C_TITLE=$'\033[1;38;5;255m'     # títulos
    C_LABEL=$'\033[38;5;244m'       # etiquetas / texto secundario
    C_TEXT=$'\033[38;5;153m'        # texto principal
    C_NUM=$'\033[38;5;215m'         # índices de menú
    C_GREEN=$'\033[38;5;114m'
    C_CYAN=$'\033[38;5;117m'
    C_YELLOW=$'\033[38;5;221m'
    C_RED=$'\033[38;5;210m'
    C_LINE=$'\033[38;5;238m'
    C_PROMPT=$'\033[1;38;5;16;48;5;114m'
else
    C_RESET=""; C_TITLE=""; C_LABEL=""; C_TEXT=""; C_NUM=""; C_GREEN=""
    C_CYAN=""; C_YELLOW=""; C_RED=""; C_LINE=""; C_PROMPT=""
fi

# Ancho adaptado a la pantalla del teléfono (máx. 64 columnas)
UI_COLS=$(tput cols 2>/dev/null || echo 64)
[[ "$UI_COLS" =~ ^[0-9]+$ ]] || UI_COLS=64
UI_WIDTH=$(( UI_COLS - 2 ))
(( UI_WIDTH > 64 )) && UI_WIDTH=64
(( UI_WIDTH < 30 )) && UI_WIDTH=30

ui_clear() { [ -t 1 ] && clear; }

ui_line() {
    local s
    printf -v s '%*s' "$UI_WIDTH" ''
    printf '%s%s%s\n' "$C_LINE" "${s// /─}" "$C_RESET"
}

# ui_header "TÍTULO" "subtítulo"
ui_header() {
    printf '\n  %s%s%s  %s·  %s%s\n\n' "$C_TITLE" "$1" "$C_RESET" "$C_LABEL" "$2" "$C_RESET"
}

# ui_section "TÍTULO"
ui_section() {
    printf '\n'
    ui_line
    printf '  %s%s%s\n\n' "$C_TITLE" "$1" "$C_RESET"
}

# ui_kv "ETIQUETA" "valor" [color]
ui_kv() {
    local pad=$(( 12 - ${#1} ))
    (( pad < 1 )) && pad=1
    printf '  %s%s%*s%s%s%s\n' "$C_LABEL" "$1" "$pad" '' "${3:-$C_TEXT}" "$2" "$C_RESET"
}

# ui_item clave "texto" [nota] [color_texto]
ui_item() {
    local k="$1"
    [[ "$k" =~ ^[0-9]+$ ]] && printf -v k '%02d' "$((10#$k))"
    printf '  %s%-3s%s %s%s%s' "$C_NUM" "$k" "$C_RESET" "${4:-$C_TEXT}" "$2" "$C_RESET"
    [ -n "$3" ] && printf '  %s%s%s' "$C_LABEL" "$3" "$C_RESET"
    printf '\n'
}

# ui_prompt variable ["pregunta"] [defecto]
ui_prompt() {
    local __var="$1" __label="$2" __def="$3" __in
    if [ -n "$__label" ]; then
        printf '  %s%s%s' "$C_TEXT" "$__label" "$C_RESET"
        [ -n "$__def" ] && printf ' %s[%s]%s' "$C_LABEL" "$__def" "$C_RESET"
        printf '\n'
    fi
    printf '  %s › %s ' "$C_PROMPT" "$C_RESET"
    IFS= read -r __in </dev/tty
    printf -v "$__var" '%s' "${__in:-$__def}"
}

# ui_confirm "pregunta" [s|n]  -> 0 si responde sí
ui_confirm() {
    local def="${2:-n}" hint r
    [ "$def" = "s" ] && hint="S/n" || hint="s/N"
    printf '  %s%s%s %s(%s)%s %s›%s ' "$C_TEXT" "$1" "$C_RESET" "$C_LABEL" "$hint" "$C_RESET" "$C_GREEN" "$C_RESET"
    IFS= read -r r </dev/tty
    r="${r:-$def}"
    [[ "$r" =~ ^[sSyY]$ ]]
}

# Quita ceros a la izquierda: "01" -> "1"
norm_opt() { local o="$1"; while [[ "$o" == 0?* ]]; do o="${o#0}"; done; echo "$o"; }

msg() {
    local text="$1" tag color tcolor="$C_TEXT"
    case "${2:-OTHER}" in
        INFO)    tag="info"; color="$C_CYAN" ;;
        SUCCESS) tag=" ok "; color="$C_GREEN" ;;
        WARNING) tag="warn"; color="$C_YELLOW" ;;
        ERROR)   tag="err "; color="$C_RED"; tcolor="$C_RED" ;;
        DEBUG)   tag=" .. "; color="$C_LABEL"; tcolor="$C_LABEL" ;;
        *)       tag="    "; color="$C_LABEL"; tcolor="$C_LABEL" ;;
    esac
    printf '  %s%s%s  %s%s%s\n' "$color" "$tag" "$C_RESET" "$tcolor" "$text" "$C_RESET"
}

pause_continue() {
    printf '\n  %s%s · ENTER para continuar%s ' "$C_LABEL" "${1:-Listo}" "$C_RESET"
    read -r _ </dev/tty
}

acortar_ruta() {
    local p="$1" max="${2:-48}"
    p="${p/#$STORAGE_ROOT/sdcard}"
    p="${p/#$CURRENT_USER_HOME/\~}"
    (( ${#p} > max )) && p="...${p: -$((max - 3))}"
    echo "$p"
}

fecha_pe() {
    TZ="America/Lima" date "+%Y-%m-%d_%H:%M:%S" 2>/dev/null \
        || date -u -d "-5 hours" "+%Y-%m-%d_%H:%M:%S" 2>/dev/null
}

