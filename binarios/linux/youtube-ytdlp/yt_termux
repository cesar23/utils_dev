# termux | wsl | gitbash | ubuntu | redhat | unknown
detect_system() {
    if [ -f /data/data/com.termux/files/usr/bin/pkg ]; then
        echo "termux"
    elif [ -n "$WSL_DISTRO_NAME" ] || [ -n "$WSL_INTEROP" ] || grep -qiE "microsoft|wsl" /proc/version 2>/dev/null; then
        echo "wsl"
    elif [ -n "$MSYSTEM" ]; then
        echo "gitbash"
    elif [ -f /etc/os-release ]; then
        local ids
        ids=$( . /etc/os-release; echo "${ID} ${ID_LIKE}" )
        case "$ids" in
            *ubuntu*|*debian*) echo "ubuntu" ;;
            *rhel*|*centos*|*fedora*|*rocky*|*almalinux*) echo "redhat" ;;
            *) echo "unknown" ;;
        esac
    else
        echo "unknown"
    fi
}

instalar_paquete() {
    if command -v pkg >/dev/null 2>&1; then
        pkg install -y "$1"
    else
        msg "No se encontró 'pkg'. ¿Estás en Termux? Instala '$1' manualmente" "ERROR"
        return 1
    fi
}

# ¿Termux tiene acceso al almacenamiento compartido (/storage/emulated/0)?
almacenamiento_disponible() {
    [ -d "$STORAGE_ROOT" ] && [ -w "$STORAGE_ROOT" ]
}

verificar_almacenamiento() {
    almacenamiento_disponible && return 0

    msg "Termux no tiene permiso para el almacenamiento del teléfono" "WARNING"
    msg "Sin él, los videos se guardan dentro de Termux (no aparecen en la galería)" "WARNING"

    if command -v termux-setup-storage >/dev/null 2>&1; then
        if ui_confirm "¿Conceder el permiso ahora (termux-setup-storage)?" s; then
            termux-setup-storage
            pause_continue "Acepta el permiso en la ventana de Android"
        fi
    fi

    if almacenamiento_disponible; then
        msg "Almacenamiento disponible" "SUCCESS"
        return 0
    fi
    return 1
}

# Evita que Android suspenda Termux durante descargas largas
activar_wakelock() {
    [ "$WAKELOCK_ACTIVO" -eq 1 ] && return 0
    if command -v termux-wake-lock >/dev/null 2>&1; then
        termux-wake-lock >/dev/null 2>&1 && WAKELOCK_ACTIVO=1
    fi
    return 0
}

liberar_wakelock() {
    if [ "$WAKELOCK_ACTIVO" -eq 1 ] && command -v termux-wake-unlock >/dev/null 2>&1; then
        termux-wake-unlock >/dev/null 2>&1
    fi
    WAKELOCK_ACTIVO=0
    return 0
}

trap liberar_wakelock EXIT

ruta_descargas_defecto() {
    if almacenamiento_disponible; then
        echo "${STORAGE_ROOT}/Download/youtube"
    else
        echo "${CURRENT_USER_HOME}/downloads/youtube"
    fi
}

# =============================================================================
#  Runtime JavaScript (YouTube exige resolver desafíos JS)
#  En Termux no hay Deno oficial: se usa Node.js (pkg install nodejs)
# =============================================================================

detectar_js_runtime() {
    JS_RUNTIME="none"
    JS_RUNTIME_ARGS=()

    if ! command -v deno >/dev/null 2>&1 && [ -x "${CURRENT_USER_HOME}/.deno/bin/deno" ]; then
        export PATH="${CURRENT_USER_HOME}/.deno/bin:${PATH}"
    fi

    if command -v deno >/dev/null 2>&1; then
        JS_RUNTIME="deno"
    elif command -v node >/dev/null 2>&1; then
        local major
        major=$(node -v 2>/dev/null | sed 's/^v//; s/\..*//')
        if [[ "$major" =~ ^[0-9]+$ ]] && [ "$major" -ge 20 ]; then
            JS_RUNTIME="node"
            JS_RUNTIME_ARGS=(--js-runtimes node)
        fi
    fi

    if [ "$JS_RUNTIME" = "none" ]; then
        local q
        for q in qjs quickjs; do
            if command -v "$q" >/dev/null 2>&1; then
                JS_RUNTIME="quickjs"
                JS_RUNTIME_ARGS=(--js-runtimes quickjs)
                break
            fi
        done
    fi
}

instalar_runtime_js() {
    msg "Instalando Node.js (runtime JavaScript para YouTube)..." "INFO"
    if instalar_paquete nodejs; then
        hash -r
        detectar_js_runtime
        if [ "$JS_RUNTIME" != "none" ]; then
            msg "Runtime JavaScript listo: ${JS_RUNTIME} ($(node -v 2>/dev/null))" "SUCCESS"
            preparar_args_ytdlp
            return 0
        fi
        msg "Node.js instalado pero es menor a v20. Prueba: pkg upgrade" "WARNING"
    fi
    msg "No se pudo preparar el runtime JavaScript" "ERROR"
    return 1
}

COOKIES_URL="https://raw.githubusercontent.com/cesar23/utils_dev/refs/heads/master/binarios/linux/youtube-ytdlp/cookies.txt"

# Descarga el cookies.txt del repositorio y sobrescribe ~/.yt-downloader/cookies.txt
descargar_cookies() {
    ui_section "DESCARGAR COOKIES"
    ui_kv "ORIGEN"  "$COOKIES_URL" "$C_LABEL"
    ui_kv "DESTINO" "$COOKIES_FILE" "$C_CYAN"
    echo

    if ! command -v curl >/dev/null 2>&1; then
        msg "Se necesita curl para descargar las cookies" "ERROR"
        pause_continue
        return 1
    fi

    local tmp total
    tmp=$(mktemp)
    msg "Descargando cookies..." "INFO"

    if ! curl -fsSL --max-time 20 -o "$tmp" "$COOKIES_URL"; then
        rm -f "$tmp"
        msg "No se pudo descargar el archivo (revisa la URL o tu conexión)" "ERROR"
        pause_continue
        return 1
    fi

    # Formato Netscape: líneas con 7 campos separados por tabulador
    total=$(awk -F'\t' '!/^#/ && NF>=7' "$tmp" | wc -l)
    if [ "$total" -eq 0 ]; then
        rm -f "$tmp"
        msg "El archivo descargado no contiene cookies válidas (formato Netscape)" "ERROR"
        pause_continue
        return 1
    fi

    [ -s "$COOKIES_FILE" ] && cp -f "$COOKIES_FILE" "${COOKIES_FILE}.bak"
    mv -f "$tmp" "$COOKIES_FILE"
    chmod 600 "$COOKIES_FILE"
    preparar_args_ytdlp

    ui_kv "COOKIES" "$total" "$C_GREEN"
    [ -f "${COOKIES_FILE}.bak" ] && ui_kv "RESPALDO" "${COOKIES_FILE}.bak" "$C_LABEL"
    echo
    msg "Cookies actualizadas. yt-dlp las usará en las próximas descargas" "SUCCESS"
    pause_continue
}

# Valida formato Netscape: cabecera típica o líneas con 7 campos separados por TAB
cookies_validas() {
    [ -s "$1" ] || return 1
    head -n 5 "$1" | grep -qiE "Netscape HTTP Cookie File|^# HTTP Cookie File" && return 0
    awk -F'\t' 'NF>=7 { ok=1; exit } END { exit !ok }' "$1"
}

importar_cookies() {
    local origen="${1/#\~/$CURRENT_USER_HOME}"

    if [ ! -f "$origen" ]; then
        msg "No existe el archivo: $origen" "ERROR"
        return 1
    fi
    if ! cookies_validas "$origen"; then
        msg "El archivo no está en formato Netscape (cookies.txt)" "ERROR"
        return 1
    fi
    if ! grep -q "youtube.com" "$origen"; then
        msg "El archivo no contiene cookies de youtube.com" "WARNING"
        ui_confirm "¿Importarlo de todas formas?" n || return 1
    fi

    [ -s "$COOKIES_FILE" ] && cp -f "$COOKIES_FILE" "${COOKIES_FILE}.bak"
    if cp "$origen" "$COOKIES_FILE"; then
        chmod 600 "$COOKIES_FILE"
        preparar_args_ytdlp
        msg "Cookies importadas en ${COOKIES_FILE}" "SUCCESS"
    else
        msg "No se pudieron copiar las cookies" "ERROR"
        return 1
    fi

    # La carpeta Download es legible por otras apps: ofrecer borrar la copia
    if [[ "$origen" == /storage/* || "$origen" == /sdcard/* ]]; then
        msg "La copia en el teléfono contiene la sesión de YouTube" "WARNING"
        ui_confirm "¿Borrar esa copia ahora?" n && rm -f "$origen" && msg "Copia borrada: $origen" "SUCCESS"
    fi
    return 0
}

mostrar_ayuda_cookies() {
    ui_section "CÓMO OBTENER COOKIES"
    msg "1. En el navegador, abre una ventana privada e inicia sesión en youtube.com" "DEBUG"
    msg "2. Exporta las cookies en formato 'cookies.txt' (Netscape)" "DEBUG"
    msg "   p. ej. 'Get cookies.txt LOCALLY' en PC o una extensión en Firefox Android" "DEBUG"
    msg "3. Cierra la ventana privada (así YouTube no invalida esas cookies)" "DEBUG"
    msg "4. Copia el archivo al teléfono como: ${COOKIES_IMPORT_DEFAULT}" "DEBUG"
    msg "5. Usa 'Importar desde archivo' en este menú" "DEBUG"
    echo
    msg "Las cookies caducan. Si vuelve el error de 'bot', expórtalas de nuevo" "WARNING"
}

gestionar_cookies() {
    local op ruta
    while true; do
        ui_clear
        ui_header "COOKIES" "youtube.com"
        if [ -s "$COOKIES_FILE" ]; then
            ui_kv "ESTADO" "activas" "$C_GREEN"
            ui_kv "FECHA"  "$(date -r "$COOKIES_FILE" "+%Y-%m-%d %H:%M" 2>/dev/null)" "$C_LABEL"
            ui_kv "YOUTUBE" "$(grep -c "youtube.com" "$COOKIES_FILE" 2>/dev/null) cookies" "$C_LABEL"
        else
            ui_kv "ESTADO" "no configuradas" "$C_LABEL"
        fi
        echo
        ui_line
        echo
        ui_item 1 "Descargar del repositorio" "sobrescribe"
        ui_item 2 "Importar desde archivo"
        ui_item 3 "Eliminar cookies"
        ui_item 4 "¿Cómo obtener mis cookies?"
        ui_item x "Volver" "" "$C_RED"
        echo
        ui_prompt op

        case "$(norm_opt "$op")" in
            1) descargar_cookies ;;
            2)
                echo
                ui_prompt ruta "Ruta del archivo" "$COOKIES_IMPORT_DEFAULT"
                importar_cookies "$ruta"
                pause_continue
                ;;
            3)
                echo
                if [ -f "$COOKIES_FILE" ]; then
                    if ui_confirm "¿Eliminar las cookies guardadas?" n; then
                        rm -f "$COOKIES_FILE"
                        preparar_args_ytdlp
                        msg "Cookies eliminadas" "SUCCESS"
                    fi
                else
                    msg "No hay cookies guardadas" "WARNING"
                fi
                pause_continue
                ;;
            4) mostrar_ayuda_cookies; pause_continue ;;
            *) return 0 ;;
        esac
    done
}

preparar_args_ytdlp() {
    YTDLP_COMMON=("${JS_RUNTIME_ARGS[@]}")
    [ -s "$COOKIES_FILE" ] && YTDLP_COMMON+=(--cookies "$COOKIES_FILE")
}

# =============================================================================
#  yt-dlp · instalación y estado
# =============================================================================

ytdlp_dias_antiguedad() {
    local v ts_v
    v=$(echo "$1" | cut -d. -f1-3 | tr . -)
    ts_v=$(date -d "$v" +%s 2>/dev/null) || return 1
    echo $(( ($(date +%s) - ts_v) / 86400 ))
}

refrescar_estado() {
    hash -r
    YTDLP_VERSION=$(yt-dlp --version 2>/dev/null)
    YTDLP_DIAS=$(ytdlp_dias_antiguedad "$YTDLP_VERSION")
    detectar_js_runtime
    preparar_args_ytdlp
}

instalar_ytdlp() {
    if ! command -v python >/dev/null 2>&1; then
        msg "yt-dlp necesita Python. Instalando..." "INFO"
        instalar_paquete python || return 1
    fi

    msg "Instalando / actualizando yt-dlp con pip..." "INFO"
    if ! pip install --upgrade "yt-dlp[default]"; then
        # Alguna dependencia opcional puede no compilar en Android
        msg "Falló yt-dlp[default]. Instalando yt-dlp + yt-dlp-ejs..." "WARNING"
        pip install --upgrade yt-dlp yt-dlp-ejs || pip install --upgrade yt-dlp || {
            msg "Error al instalar yt-dlp" "ERROR"
            return 1
        }
    fi

    hash -r
    msg "yt-dlp listo: $(yt-dlp --version 2>/dev/null) ($(command -v yt-dlp))" "SUCCESS"
    return 0
}

verificar_dependencias() {
    if ! command -v yt-dlp >/dev/null 2>&1; then
        msg "yt-dlp no está instalado" "ERROR"
        if ui_confirm "¿Instalarlo ahora?" s; then
            instalar_ytdlp || exit 1
        else
            exit 1
        fi
    fi

    if ! command -v ffmpeg >/dev/null 2>&1; then
        msg "ffmpeg no está instalado (necesario para unir video+audio y convertir audio)" "WARNING"
        ui_confirm "¿Instalar ffmpeg ahora?" s && { instalar_paquete ffmpeg; hash -r; }
        if ! command -v ffmpeg >/dev/null 2>&1; then
            ui_confirm "¿Continuar sin ffmpeg?" n || exit 1
        fi
    fi

    detectar_js_runtime
    if [ "$JS_RUNTIME" = "none" ]; then
        msg "No hay runtime JavaScript (node). Sin él YouTube oculta formatos" "WARNING"
        msg "y yt-dlp falla con 'Requested format is not available'." "WARNING"
        ui_confirm "¿Instalar Node.js ahora?" s && instalar_runtime_js
    fi

    # Si hay un cookies.txt en Download y aún no se importó
    if [ ! -s "$COOKIES_FILE" ] && [ -f "$COOKIES_IMPORT_DEFAULT" ]; then
        msg "Se encontró ${COOKIES_IMPORT_DEFAULT}" "INFO"
        ui_confirm "¿Importar esas cookies para YouTube?" s && importar_cookies "$COOKIES_IMPORT_DEFAULT"
    fi

    refrescar_estado
}

verificar_version_ytdlp() {
    ui_section "ESTADO DE HERRAMIENTAS"

    if ! command -v yt-dlp >/dev/null 2>&1; then
        msg "yt-dlp no está instalado" "ERROR"
        return 1
    fi

    local ultima ffm="instalado" ffm_c="$C_GREEN"
    command -v ffmpeg >/dev/null 2>&1 || { ffm="no instalado"; ffm_c="$C_RED"; }

    ultima=$(curl -fsS --max-time 10 https://api.github.com/repos/yt-dlp/yt-dlp/releases/latest 2>/dev/null \
        | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)

    ui_kv "SISTEMA"  "$SO_SYSTEM" "$C_YELLOW"
    ui_kv "YT-DLP"   "$YTDLP_VERSION" "$C_GREEN"
    ui_kv "RUTA"     "$(command -v yt-dlp)" "$C_LABEL"
    ui_kv "ULTIMA"   "${ultima:-sin conexión}" "$C_CYAN"
    ui_kv "RUNTIME"  "$JS_RUNTIME" "$([ "$JS_RUNTIME" = none ] && echo "$C_RED" || echo "$C_GREEN")"
    ui_kv "FFMPEG"   "$ffm" "$ffm_c"
    if [ -s "$COOKIES_FILE" ]; then
        ui_kv "COOKIES" "activas" "$C_GREEN"
    else
        ui_kv "COOKIES" "no configuradas" "$C_LABEL"
    fi
    if almacenamiento_disponible; then
        ui_kv "STORAGE" "accesible" "$C_GREEN"
    else
        ui_kv "STORAGE" "sin permiso · termux-setup-storage" "$C_RED"
    fi
    echo

    if [ -z "$ultima" ]; then
        msg "No se pudo consultar GitHub. Revisa tu conexión." "WARNING"
        return 1
    elif [ "$YTDLP_VERSION" = "$ultima" ]; then
        msg "yt-dlp está al día" "SUCCESS"
    else
        msg "Hay una versión nueva disponible: ${YTDLP_VERSION} → ${ultima}" "WARNING"
    fi
    return 0
}

mostrar_comandos_manuales() {
    ui_section "COMANDOS MANUALES · TERMUX"
    printf '  %s$%s pkg update && pkg upgrade\n' "$C_LABEL" "$C_RESET"
    printf '  %s$%s pkg install python ffmpeg nodejs\n' "$C_LABEL" "$C_RESET"
    printf '  %s$%s pip install --upgrade "yt-dlp[default]"\n' "$C_LABEL" "$C_RESET"
    printf '  %s$%s termux-setup-storage   %s# permiso para Download%s\n' "$C_LABEL" "$C_RESET" "$C_LABEL" "$C_RESET"
}

actualizar_ytdlp() {
    ui_clear
    ui_header "MANTENIMIENTO" "actualizar herramientas"
    verificar_version_ytdlp

    local op
    ui_section "MÉTODO"
    ui_item 1 "pip install --upgrade yt-dlp" "recomendado"
    ui_item 2 "Instalar / actualizar Node.js" "runtime JS"
    ui_item 3 "Todo: yt-dlp + Node.js + ffmpeg" "si algo falla"
    ui_item 4 "Mostrar comandos manuales"
    ui_item x "Cancelar" "" "$C_RED"
    echo
    ui_prompt op "" 1

    case "$(norm_opt "$op")" in
        1) instalar_ytdlp ;;
        2) instalar_runtime_js ;;
        3)
            instalar_ytdlp
            instalar_runtime_js
            command -v ffmpeg >/dev/null 2>&1 || { instalar_paquete ffmpeg; hash -r; }
            ;;
        4) mostrar_comandos_manuales ;;
        *) msg "Cancelado" "INFO" ;;
    esac

    refrescar_estado
    pause_continue "Mantenimiento finalizado"
}

