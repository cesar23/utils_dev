string_slugify() {
    local input="$1" case="$2" first rest
    [[ -z "$input" ]] && echo "" && return

    input="$(echo "$input" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
    case "$case" in
        lower) input="$(echo "$input" | tr '[:upper:]' '[:lower:]')" ;;
        upper) input="$(echo "$input" | tr '[:lower:]' '[:upper:]')" ;;
        capitalize)
            first="$(echo "${input:0:1}" | tr '[:lower:]' '[:upper:]')"
            rest="$(echo "${input:1}" | tr '[:upper:]' '[:lower:]')"
            input="$first$rest"
            ;;
        title) input="$(echo "$input" | awk '{for(i=1;i<=NF;i++){ $i=toupper(substr($i,1,1)) tolower(substr($i,2)) }}1')" ;;
        none|"") ;;
        *) echo "Error: usa lower, upper, capitalize, title o none."; return 1 ;;
    esac

    input="$(echo "$input" | sed 's/[^[:alnum:] _-]//g')"
    input="$(echo "$input" | sed -E 's/[[:space:]_]+/-/g')"
    input="$(echo "$input" | sed -E 's/^-+|-+$//g')"
    echo "$input"
}

verificar_espacio_disco() {
    local kb gb
    kb=$(df -k "$1" 2>/dev/null | awk 'NR==2 {print $4}')
    [[ "$kb" =~ ^[0-9]+$ ]] || return 0
    gb=$(( kb / 1024 / 1024 ))
    ui_kv "LIBRE" "${gb} GB" "$([ "$gb" -lt 1 ] && echo "$C_RED" || echo "$C_GREEN")"

    if [ "$gb" -lt 1 ]; then
        msg "Menos de 1 GB de espacio libre" "WARNING"
        ui_confirm "¿Continuar de todas formas?" n || { msg "Cancelado" "INFO"; return 1; }
    fi
    return 0
}

guardar_historial() {
    echo "$(date "+%Y-%m-%d %H:%M:%S")|$3|$2|$1" >> "$HISTORIAL_FILE"
    msg "Registrado en el historial" "DEBUG"
}

# 0 = ya descargado y el usuario NO quiere repetir
verificar_descarga_previa() {
    local url="$1" ultima
    [ -f "$HISTORIAL_FILE" ] || return 1
    grep -qF "$url" "$HISTORIAL_FILE" || return 1

    ultima=$(grep -F "$url" "$HISTORIAL_FILE" | tail -1)
    echo
    msg "Esta URL ya fue descargada" "WARNING"
    ui_kv "FECHA"  "$(echo "$ultima" | cut -d'|' -f1)" "$C_LABEL"
    ui_kv "TITULO" "$(echo "$ultima" | cut -d'|' -f3)" "$C_LABEL"
    echo
    ui_confirm "¿Descargar nuevamente?" n && return 1
    return 0
}

validar_url() {
    if [[ -z "$1" ]]; then
        msg "No se ingresó ninguna URL" "ERROR"
        return 1
    fi
    if [[ ! "$1" =~ ^https?://(www\.|m\.|music\.)?(youtube\.com|youtu\.be) ]]; then
        msg "La URL no parece ser de YouTube" "WARNING"
        ui_confirm "¿Continuar de todas formas?" n || { msg "Cancelado" "INFO"; return 1; }
    fi
    return 0
}

extraer_url_video() { echo "${1%%&*}"; }

leer_ultima_ruta() { [ -f "$LAST_PATH_FILE" ] && cat "$LAST_PATH_FILE"; }
guardar_ultima_ruta() { echo "$1" > "$LAST_PATH_FILE"; }

solicitar_ruta_descarga() {
    local ultima input
    ultima=$(leer_ultima_ruta)
    [[ -n "$ultima" && -d "$ultima" ]] && DOWNLOADS_PATH="$ultima"

    ui_section "DESTINO"
    ui_kv "CARPETA" "$DOWNLOADS_PATH" "$C_CYAN"
    echo
    ui_prompt input "Nueva ruta, '.' = carpeta actual, ENTER = mantener"

    if [ -n "$input" ]; then
        [ "$input" = "." ] && DOWNLOADS_PATH="$PWD" || DOWNLOADS_PATH="${input/#\~/$CURRENT_USER_HOME}"
    fi

    if [ ! -d "$DOWNLOADS_PATH" ]; then
        msg "Creando carpeta: $DOWNLOADS_PATH" "INFO"
        if ! mkdir -p "$DOWNLOADS_PATH"; then
            msg "No se pudo crear: $DOWNLOADS_PATH" "ERROR"
            [[ "$DOWNLOADS_PATH" == /storage/* ]] && msg "Ejecuta: termux-setup-storage" "INFO"
            return 1
        fi
    fi

    guardar_ultima_ruta "$DOWNLOADS_PATH"
    echo
    ui_kv "CARPETA" "$DOWNLOADS_PATH" "$C_CYAN"
    verificar_espacio_disco "$DOWNLOADS_PATH" || return 1
}

# El almacenamiento compartido de Android no admite : ? " * |
args_ruta() {
    ARGS_RUTA=()
    [[ "$DOWNLOADS_PATH" == /storage/* || "$DOWNLOADS_PATH" == /sdcard* ]] && ARGS_RUTA=(--windows-filenames)
}

# =============================================================================
#  Información del video y selección de formato
# =============================================================================

limpiar_na() { [ "$1" = "NA" ] && echo "" || echo "$1"; }

obtener_info_video() {
    local url="$1" errlog salida bytes
    local -a l

    VIDEO_TITULO=""; VIDEO_AUTOR=""; VIDEO_DURACION=""; VIDEO_TAMANO=""; VIDEO_ID=""
    msg "Obteniendo información del video..." "INFO"

    errlog=$(mktemp)
    salida=$(yt-dlp "${YTDLP_COMMON[@]}" --no-playlist --skip-download --ignore-no-formats-error --no-warnings \
        --print "%(title)s" --print "%(uploader)s" --print "%(duration_string)s" \
        --print "%(filesize_approx)s" --print "%(id)s" "$url" 2>"$errlog")
    mapfile -t l <<< "$salida"

    VIDEO_TITULO=$(limpiar_na "${l[0]}")
    VIDEO_AUTOR=$(limpiar_na "${l[1]}")
    VIDEO_DURACION=$(limpiar_na "${l[2]}")
    bytes=$(limpiar_na "${l[3]}")
    VIDEO_ID=$(limpiar_na "${l[4]}")

    if [[ "$bytes" =~ ^[0-9]+$ ]] && [ "$bytes" -gt 0 ]; then
        VIDEO_TAMANO="$((bytes / 1024 / 1024)) MB"
    else
        VIDEO_TAMANO="desconocido"
    fi

    if [ -z "$VIDEO_ID" ] && [ -z "$VIDEO_TITULO" ]; then
        msg "No se pudo obtener información del video" "ERROR"
        grep -E "ERROR" "$errlog" | tail -n 3 | while IFS= read -r linea; do
            msg "$linea" "DEBUG"
        done
        rm -f "$errlog"
        return 1
    fi

    rm -f "$errlog"
    [ -z "$VIDEO_TITULO" ] && VIDEO_TITULO="video-${VIDEO_ID}"
    return 0
}

mostrar_info_video() {
    local t="$VIDEO_TITULO"
    (( ${#t} > 50 )) && t="${t:0:47}..."
    ui_section "VIDEO"
    ui_kv "TITULO"   "$t" "$C_TITLE"
    ui_kv "CANAL"    "${VIDEO_AUTOR:-desconocido}" "$C_YELLOW"
    ui_kv "DURACION" "${VIDEO_DURACION:-desconocida}" "$C_GREEN"
    ui_kv "PESO"     "$VIDEO_TAMANO" "$C_CYAN"
    ui_kv "ID"       "$VIDEO_ID" "$C_LABEL"
}

slug_titulo_video() {
    local slug
    slug=$(string_slugify "$VIDEO_TITULO" title)
    [ -z "$slug" ] && slug="video-${VIDEO_ID:-$(date +%s)}"
    echo "$slug"
}

# YouTube entrega video y audio separados; ffmpeg los une.
# Se prefiere H.264 + AAC (compatible con Premiere, Windows y móviles).
formato_mp4() {
    local hf=""
    [ -n "$1" ] && hf="[height<=$1]"
    echo "bv*${hf}[vcodec^=avc1]+ba[ext=m4a]/bv*${hf}[ext=mp4]+ba[ext=m4a]/bv*${hf}+ba/b${hf}/b"
}

seleccionar_calidad_video() {
    local op
    ui_section "CALIDAD"
    ui_item 1 "Mejor calidad MP4" "H.264 + AAC · recomendado"
    ui_item 2 "Hasta 1080p MP4"
    ui_item 3 "Hasta 720p MP4"
    ui_item 4 "Hasta 480p MP4"
    ui_item 5 "Hasta 360p MP4"
    ui_item 6 "Máxima calidad MKV" "VP9 / AV1"
    ui_item 7 "Personalizado" "avanzado"
    echo
    ui_prompt op "" 1

    FORMATO_CONTENEDOR="mp4"
    case "$(norm_opt "$op")" in
        2) FORMATO_VIDEO=$(formato_mp4 1080) ;;
        3) FORMATO_VIDEO=$(formato_mp4 720) ;;
        4) FORMATO_VIDEO=$(formato_mp4 480) ;;
        5) FORMATO_VIDEO=$(formato_mp4 360) ;;
        6) FORMATO_VIDEO="bv*+ba/b"; FORMATO_CONTENEDOR="mkv" ;;
        7)
            if [ -n "$URL_ACTUAL" ]; then
                msg "Formatos disponibles:" "INFO"
                yt-dlp "${YTDLP_COMMON[@]}" --no-playlist -F "$URL_ACTUAL" </dev/null
            fi
            msg "Ejemplos: 137+140 · bv*[height<=1080]+ba · 18" "DEBUG"
            ui_prompt FORMATO_VIDEO "Selector de formato" "bv*+ba/b"
            ui_prompt FORMATO_CONTENEDOR "Contenedor (mp4/mkv/webm)" "mkv"
            ;;
        *) FORMATO_VIDEO=$(formato_mp4 "") ;;
    esac
    msg "Formato: ${FORMATO_VIDEO} → ${FORMATO_CONTENEDOR}" "DEBUG"
}

configurar_subtitulos() {
    echo
    if ui_confirm "¿Descargar subtítulos (es, en)?" n; then
        SUBTITULOS_ARGS=(--write-auto-sub --sub-lang "es,en" --convert-subs srt --embed-subs)
        msg "Subtítulos activados" "DEBUG"
    else
        SUBTITULOS_ARGS=()
    fi
}

seleccionar_formato_audio() {
    local op
    ui_section "FORMATO DE AUDIO"
    ui_item 1 "MP3" "recomendado"
    ui_item 2 "M4A"
    ui_item 3 "OPUS"
    ui_item 4 "WAV"
    echo
    ui_prompt op "" 1
    case "$(norm_opt "$op")" in
        2) FORMATO_AUDIO="m4a" ;;
        3) FORMATO_AUDIO="opus" ;;
        4) FORMATO_AUDIO="wav" ;;
        *) FORMATO_AUDIO="mp3" ;;
    esac
    msg "Formato de audio: ${FORMATO_AUDIO}" "DEBUG"
}

# =============================================================================
#  Ejecución con reintentos y diagnóstico
# =============================================================================

# 0 = error fatal (no reintentar) · 1 = vale la pena reintentar
diagnosticar_error_ytdlp() {
    local log="$1"

    if grep -qi "Requested format is not available" "$log"; then
        msg "YouTube no devolvió formatos utilizables para este video" "ERROR"
        msg "Causa habitual: yt-dlp desactualizado o sin runtime JS (actual: ${JS_RUNTIME})" "WARNING"
        msg "Solución: menú 08 · actualizar yt-dlp / instalar Node.js" "INFO"
        return 0
    elif grep -qiE "Sign in to confirm|not a bot" "$log"; then
        msg "YouTube pide verificación anti-bot" "ERROR"
        if [ -s "$COOKIES_FILE" ]; then
            msg "Ya usas cookies, pero probablemente caducaron: renuévalas (menú 09)" "WARNING"
        else
            msg "Configura cookies: menú 09 (descargar) o 10 (importar)" "WARNING"
        fi
        return 0
    elif grep -qiE "cookies are no longer valid" "$log"; then
        msg "Las cookies guardadas ya no son válidas: renuévalas (menú 09 / 10)" "WARNING"
        return 1
    elif grep -qiE "Private video|Video unavailable|members-only|has been removed|confirm your age|age-restricted" "$log"; then
        msg "Video no disponible (privado, eliminado, +18 o solo miembros)" "ERROR"
        return 0
    elif grep -qiE "ffmpeg is not installed|ffprobe and ffmpeg not found|ffmpeg not found" "$log"; then
        msg "Falta ffmpeg: pkg install ffmpeg" "ERROR"
        return 0
    elif grep -qiE "Permission denied|Operation not permitted" "$log"; then
        msg "Sin permiso para escribir en: ${DOWNLOADS_PATH}" "ERROR"
        msg "Ejecuta termux-setup-storage y acepta el permiso de Android" "INFO"
        return 0
    elif grep -qi "HTTP Error 429" "$log"; then
        msg "YouTube limita peticiones (429). Esperando 20 s..." "WARNING"
        sleep 20
        return 1
    elif grep -qi "HTTP Error 403" "$log"; then
        msg "Error 403: suele resolverse actualizando yt-dlp (menú 08)" "WARNING"
        return 1
    fi
    return 1
}

ejecutar_con_reintentos() {
    local rc lote="$WAKELOCK_ACTIVO"
    activar_wakelock
    _ejecutar_con_reintentos "$@"
    rc=$?
    # En lotes el wake-lock se mantiene hasta terminar todas las URLs
    [ "$lote" -eq 1 ] || liberar_wakelock
    return $rc
}

_ejecutar_con_reintentos() {
    local max=3 intento=1 rc log ejs_probado=0
    local -a cmd=("$@")

    log=$(mktemp)
    echo
    printf '  %s$ %s%s\n\n' "$C_LABEL" "$(printf '%q ' "${cmd[@]}")" "$C_RESET"

    while [ $intento -le $max ]; do
        msg "Intento ${intento}/${max}" "INFO"

        "${cmd[@]}" </dev/null 2>&1 | tee "$log"
        rc=${PIPESTATUS[0]}

        if [ $rc -eq 0 ]; then
            rm -f "$log"
            echo
            msg "Descarga completada" "SUCCESS"
            return 0
        fi

        if [ $ejs_probado -eq 0 ] && grep -E "^(ERROR|WARNING)" "$log" | grep -qiE "ejs|challenge|n.?sig"; then
            ejs_probado=1
            cmd=("${cmd[0]}" --remote-components ejs:github "${cmd[@]:1}")
            msg "Reintentando con --remote-components ejs:github" "WARNING"
            continue
        fi

        echo
        if diagnosticar_error_ytdlp "$log"; then
            rm -f "$log"
            msg "Reintentar no ayudará. Corrige lo indicado arriba." "ERROR"
            return 1
        fi

        if [ $intento -lt $max ]; then
            msg "Reintentando en 5 s..." "WARNING"
            sleep 5
        else
            msg "Se agotaron los intentos" "ERROR"
        fi
        ((intento++))
    done

    rm -f "$log"
    return 1
}

buscar_archivo_descargado() {
    find "$DOWNLOADS_PATH" -maxdepth 1 -type f -newer "$2" -name "${1}*" \
        ! -name "*.part" ! -name "*.ytdl" ! -name "*.srt" ! -name "*.vtt" 2>/dev/null | tail -n 1
}

# =============================================================================
#  Descargas
# =============================================================================

descargar_video_core() {
    local url="$1" slug="$2" marker rc=1
    marker=$(mktemp "${CONFIG_DIR}/marker.XXXXXX")
    args_ruta

    local -a cmd=(yt-dlp "${YTDLP_COMMON[@]}" --no-playlist -c --no-mtime
        -f "$FORMATO_VIDEO" "${SUBTITULOS_ARGS[@]}"
        --merge-output-format "$FORMATO_CONTENEDOR"
        "${ARGS_RUTA[@]}" --progress --newline
        -o "${DOWNLOADS_PATH}/${slug}.%(ext)s" "$url")

    if ejecutar_con_reintentos "${cmd[@]}"; then
        ARCHIVO_DESCARGADO=$(buscar_archivo_descargado "$slug" "$marker")
        rc=0
    fi
    rm -f "$marker"
    return $rc
}

descargar_audio_core() {
    local url="$1" slug="$2" marker rc=1
    marker=$(mktemp "${CONFIG_DIR}/marker.XXXXXX")
    args_ruta

    local -a cmd=(yt-dlp "${YTDLP_COMMON[@]}" --no-playlist -c --no-mtime
        -f "ba/b" --extract-audio --audio-format "$FORMATO_AUDIO"
        "${ARGS_RUTA[@]}" --progress --newline
        -o "${DOWNLOADS_PATH}/${slug}.%(ext)s" "$url")

    if ejecutar_con_reintentos "${cmd[@]}"; then
        ARCHIVO_DESCARGADO=$(buscar_archivo_descargado "$slug" "$marker")
        rc=0
    fi
    rm -f "$marker"
    return $rc
}

# descargar_individual URL video|audio
descargar_individual() {
    local url tipo="$2" slug ok
    url=$(extraer_url_video "$1")
    URL_ACTUAL="$url"

    if verificar_descarga_previa "$url"; then
        msg "Cancelado: ya descargado" "INFO"
        pause_continue
        return 0
    fi

    echo
    obtener_info_video "$url" || { pause_continue "No se pudo leer el video"; return 1; }
    mostrar_info_video

    if [ "$tipo" = "audio" ]; then
        seleccionar_formato_audio
    else
        seleccionar_calidad_video
        configurar_subtitulos
    fi

    slug=$(slug_titulo_video)
    ui_section "DESCARGA"

    if [ "$tipo" = "audio" ]; then
        descargar_audio_core "$url" "$slug"; ok=$?
    else
        descargar_video_core "$url" "$slug"; ok=$?
    fi

    if [ $ok -ne 0 ]; then
        pause_continue "La descarga falló"
        return 1
    fi

    echo
    if [ -n "$ARCHIVO_DESCARGADO" ]; then
        ui_kv "ARCHIVO" "$ARCHIVO_DESCARGADO" "$C_GREEN"
        guardar_historial "$url" "$VIDEO_TITULO" "$( [ "$tipo" = audio ] && echo AUDIO || echo VIDEO )"
    else
        msg "Descarga terminada, pero no se localizó el archivo" "WARNING"
    fi
    pause_continue "Descarga completada"
}

# descargar_batch URL video|audio  (sin interacción)
descargar_batch() {
    local url tipo="$2" slug ok
    url=$(extraer_url_video "$1")
    URL_ACTUAL="$url"

    obtener_info_video "$url" || return 1
    slug=$(slug_titulo_video)
    msg "${VIDEO_TITULO}" "INFO"

    if [ "$tipo" = "audio" ]; then
        descargar_audio_core "$url" "$slug"; ok=$?
    else
        descargar_video_core "$url" "$slug"; ok=$?
    fi
    [ $ok -eq 0 ] || return 1

    if [ -n "$ARCHIVO_DESCARGADO" ]; then
        msg "$(basename "$ARCHIVO_DESCARGADO")" "SUCCESS"
        guardar_historial "$url" "$VIDEO_TITULO" "$( [ "$tipo" = audio ] && echo AUDIO || echo VIDEO )"
        return 0
    fi
    msg "Descarga terminada, pero no se localizó el archivo" "WARNING"
    return 1
}

descargar_playlist() {
    local url="$1"
    URL_ACTUAL=""

    seleccionar_calidad_video
    configurar_subtitulos
    ui_section "DESCARGA DE PLAYLIST"
    args_ruta

    local -a cmd=(yt-dlp "${YTDLP_COMMON[@]}" -c --no-mtime
        -f "$FORMATO_VIDEO" "${SUBTITULOS_ARGS[@]}"
        --merge-output-format "$FORMATO_CONTENEDOR"
        --yes-playlist "${ARGS_RUTA[@]}" --progress --newline
        -o "${DOWNLOADS_PATH}/%(playlist_index)02d-%(title)s.%(ext)s" "$url")

    if ! ejecutar_con_reintentos "${cmd[@]}"; then
        pause_continue "La descarga de la playlist falló"
        return 1
    fi
    guardar_historial "$url" "PLAYLIST" "PLAYLIST"

    echo
    if ui_confirm "¿Renombrar los archivos a formato slug?" n; then
        local count=0 archivo nombre extension base slug nuevo
        for archivo in "${DOWNLOADS_PATH}"/*.{mp4,mkv,webm,flv}; do
            [ -e "$archivo" ] || continue
            nombre=$(basename "$archivo")
            extension="${nombre##*.}"
            base="${nombre%.*}"
            slug=$(string_slugify "$base" title)
            nuevo="${DOWNLOADS_PATH}/${slug}.${extension}"
            if [[ "$archivo" != "$nuevo" ]]; then
                msg "${nombre} → ${slug}.${extension}" "DEBUG"
                mv "$archivo" "$nuevo"
                ((count++))
            fi
        done
        if [ $count -gt 0 ]; then
            msg "Renombrados: $count archivo(s)" "SUCCESS"
        else
            msg "No había archivos para renombrar" "WARNING"
        fi
    fi

    pause_continue "Playlist completada"
}

descargar_por_lotes() {
    local archivo_urls tipo total contador=0 exitosos=0 fallidos=0 url modo

    ui_section "DESCARGA POR LOTES"
    msg "Archivo de texto con una URL por línea. Líneas con # se ignoran." "DEBUG"
    msg "Ejemplo: ${STORAGE_ROOT}/Download/urls.txt" "DEBUG"
    echo
    ui_prompt archivo_urls "Ruta del archivo con URLs"
    archivo_urls="${archivo_urls/#\~/$CURRENT_USER_HOME}"

    if [[ ! -f "$archivo_urls" ]]; then
        msg "El archivo no existe: $archivo_urls" "ERROR"
        pause_continue
        return 1
    fi

    total=$(tr -d '\r' < "$archivo_urls" | grep -v "^[[:space:]]*#" | grep -cE "^[[:space:]]*https?://")
    if [ "$total" -eq 0 ]; then
        msg "No se encontraron URLs válidas" "ERROR"
        pause_continue
        return 1
    fi
    msg "${total} URL(s) encontradas" "INFO"

    ui_section "TIPO"
    ui_item 1 "Video"
    ui_item 2 "Solo audio"
    echo
    ui_prompt tipo "" 1

    if [ "$(norm_opt "$tipo")" = "2" ]; then
        modo="audio"
        seleccionar_formato_audio
    else
        modo="video"
        URL_ACTUAL=""
        seleccionar_calidad_video
        configurar_subtitulos
    fi

    activar_wakelock
    while IFS= read -r url || [ -n "$url" ]; do
        url=$(echo "$url" | tr -d '[:space:]')
        [[ -z "$url" || "$url" == \#* ]] && continue
        [[ "$url" =~ ^https?:// ]] || continue

        ((contador++))
        ui_section "[$contador/$total]"
        msg "$url" "DEBUG"

        if descargar_batch "$url" "$modo"; then
            ((exitosos++))
        else
            ((fallidos++))
            msg "Falló la URL #$contador" "ERROR"
        fi
    done < "$archivo_urls"
    liberar_wakelock

    ui_section "RESUMEN"
    ui_kv "TOTAL"    "$total"
    ui_kv "OK"       "$exitosos" "$C_GREEN"
    ui_kv "FALLIDAS" "$fallidos" "$([ "$fallidos" -gt 0 ] && echo "$C_RED" || echo "$C_LABEL")"
    echo
    if [ "$exitosos" -eq "$total" ]; then
        msg "Todas las descargas se completaron" "SUCCESS"
    elif [ "$exitosos" -gt 0 ]; then
        msg "Se completaron $exitosos de $total" "WARNING"
    else
        msg "No se completó ninguna descarga" "ERROR"
    fi
    pause_continue "Lote finalizado"
}

# =============================================================================
#  Historial
# =============================================================================

ver_historial() {
    ui_clear
    ui_header "HISTORIAL" "últimas 10 descargas"

    if [[ ! -s "$HISTORIAL_FILE" ]]; then
        msg "El historial está vacío" "WARNING"
        pause_continue
        return 0
    fi

    local total color fecha tipo titulo url
    total=$(wc -l < "$HISTORIAL_FILE")
    ui_kv "TOTAL" "$total" "$C_GREEN"
    echo
    ui_line

    tail -n 10 "$HISTORIAL_FILE" | while IFS='|' read -r fecha tipo titulo url; do
        case "$tipo" in
            VIDEO) color="$C_CYAN" ;;
            AUDIO) color="$C_GREEN" ;;
            *)     color="$C_YELLOW" ;;
        esac
        (( ${#titulo} > 38 )) && titulo="${titulo:0:35}..."
        printf '  %s%s%s  %s%-8s%s %s%s%s\n' "$C_LABEL" "${fecha:0:16}" "$C_RESET" \
            "$color" "$tipo" "$C_RESET" "$C_TEXT" "$titulo" "$C_RESET"
    done
    ui_line
    echo

    if ui_confirm "¿Ver historial completo?" n; then
        if command -v less >/dev/null 2>&1; then less "$HISTORIAL_FILE"; else cat "$HISTORIAL_FILE"; pause_continue; fi
    fi
}

eliminar_historial() {
    echo
    if [[ ! -s "$HISTORIAL_FILE" ]]; then
        msg "No hay historial para eliminar" "WARNING"
    elif ui_confirm "¿Eliminar todo el historial? Esta acción no se puede deshacer" n; then
        : > "$HISTORIAL_FILE"
        msg "Historial eliminado" "SUCCESS"
    else
        msg "Cancelado" "INFO"
    fi
    pause_continue
}

