ui_banner() {
    local ytv_color="$C_GREEN" ytv="$YTDLP_VERSION" ffm="ok" ffm_c="$C_GREEN" rt_c="$C_GREEN"

    if [[ "$YTDLP_DIAS" =~ ^[0-9]+$ ]] && [ "$YTDLP_DIAS" -gt 60 ]; then
        ytv_color="$C_YELLOW"
        ytv="${YTDLP_VERSION} · ${YTDLP_DIAS} días · 08"
    fi
    command -v ffmpeg >/dev/null 2>&1 || { ffm="no instalado"; ffm_c="$C_RED"; }
    [ "$JS_RUNTIME" = "none" ] && rt_c="$C_RED"

    ui_header "YT DOWNLOADER" "termux"
    ui_kv "VERSION"  "$VERSION_SCRIPT" "$C_GREEN"
    ui_kv "PLATFORM" "$SO_SYSTEM" "$C_YELLOW"
    ui_kv "YT-DLP"   "${ytv:-desconocida}" "$ytv_color"
    ui_kv "RUNTIME"  "$JS_RUNTIME" "$rt_c"
    ui_kv "FFMPEG"   "$ffm" "$ffm_c"
    if [ -s "$COOKIES_FILE" ]; then
        ui_kv "COOKIES" "activas · $(date -r "$COOKIES_FILE" "+%Y-%m-%d %H:%M" 2>/dev/null)" "$C_GREEN"
    else
        ui_kv "COOKIES" "no configuradas · 09" "$C_LABEL"
    fi
    if almacenamiento_disponible; then
        ui_kv "STORAGE" "ok" "$C_GREEN"
    else
        ui_kv "STORAGE" "sin permiso" "$C_RED"
    fi
    ui_kv "DESTINO"  "$(acortar_ruta "$(leer_ultima_ruta || true)" $(( UI_WIDTH - 14 )))" "$C_CYAN"
    ui_kv "UTC-5 PE" "$(fecha_pe)" "$C_CYAN"
    echo
    ui_line
    echo
}

pedir_url() {
    local __url
    echo
    ui_prompt __url "URL de YouTube"
    printf -v "$1" '%s' "$__url"
    validar_url "$__url"
}

menu_principal() {
    local opcion url
    while true; do
        ui_clear
        ui_banner
        ui_item 1 "Descargar video"
        ui_item 2 "Descargar playlist"
        ui_item 3 "Descargar audio"
        ui_item 4 "Descarga por lotes" "archivo URLs"
        echo
        ui_item 5 "Ver historial"
        ui_item 6 "Eliminar historial"
        echo
        ui_item 7 "Estado de herramientas"
        ui_item 8 "Actualizar yt-dlp / runtime"
        ui_item 9 "Descargar cookies" "repositorio"
        ui_item 10 "Gestionar cookies" "importar / eliminar"
        ui_item x "Salir" "" "$C_RED"
        echo
        ui_line
        echo
        ui_prompt opcion

        case "$(norm_opt "$opcion")" in
            1) pedir_url url && solicitar_ruta_descarga && descargar_individual "$url" video ;;
            2) pedir_url url && solicitar_ruta_descarga && descargar_playlist "$url" ;;
            3) pedir_url url && solicitar_ruta_descarga && descargar_individual "$url" audio ;;
            4) solicitar_ruta_descarga && descargar_por_lotes ;;
            5) ver_historial ;;
            6) eliminar_historial ;;
            7) ui_clear; verificar_version_ytdlp; pause_continue ;;
            8) actualizar_ytdlp ;;
            9) descargar_cookies ;;
            10|c|C) gestionar_cookies ;;
            x|X|q|Q) echo; msg "Hasta luego" "DEBUG"; echo; exit 0 ;;
            "") ;;
            *) msg "Opción no válida" "ERROR"; sleep 1 ;;
        esac
    done
}

menu_url() {
    local url="$1" opcion
    validar_url "$url" || exit 1

    while true; do
        ui_clear
        ui_banner
        ui_kv "URL" "$url" "$C_TEXT"
        echo
        ui_item 1 "Descargar video"
        ui_item 2 "Descargar playlist"
        ui_item 3 "Descargar audio"
        ui_item x "Salir" "" "$C_RED"
        echo
        ui_line
        echo
        ui_prompt opcion

        case "$(norm_opt "$opcion")" in
            1) solicitar_ruta_descarga || exit 1; descargar_individual "$url" video; exit $? ;;
            2) solicitar_ruta_descarga || exit 1; descargar_playlist "$url"; exit $? ;;
            3) solicitar_ruta_descarga || exit 1; descargar_individual "$url" audio; exit $? ;;
            x|X|q|Q|4) exit 0 ;;
            *) msg "Opción no válida" "ERROR"; sleep 1 ;;
        esac
    done
}

