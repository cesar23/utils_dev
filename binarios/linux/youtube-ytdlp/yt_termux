SO_SYSTEM=$(detect_system)
if [ "$SO_SYSTEM" != "termux" ]; then
    msg "Este script es para Termux (Android). Sistema detectado: ${SO_SYSTEM}" "WARNING"
    msg "En Ubuntu / WSL usa yt.sh" "WARNING"
fi

verificar_almacenamiento

DOWNLOADS_PATH=$(ruta_descargas_defecto)
if ! mkdir -p "$DOWNLOADS_PATH" 2>/dev/null; then
    DOWNLOADS_PATH="${CURRENT_USER_HOME}/downloads/youtube"
    mkdir -p "$DOWNLOADS_PATH"
fi
[ -s "$LAST_PATH_FILE" ] || guardar_ultima_ruta "$DOWNLOADS_PATH"

verificar_dependencias

if [ $# -ge 1 ]; then
    menu_url "$1"
else
    menu_principal
fi