actualizar_ytdlp() {
    clear
    echo ""
    msg "╔═══════════════════════════════════════╗" "INFO"
    msg "║    🔄 ACTUALIZAR YT-DLP               ║" "INFO"
    msg "╚═══════════════════════════════════════╝" "INFO"
    echo ""

    verificar_version_ytdlp

    echo ""
    msg "═══════════════════════════════════════" "INFO"
    msg "Selecciona el método de actualización:" "INFO"
    msg "═══════════════════════════════════════" "INFO"
    echo ""

    local sistema="$SO_SYSTEM"
    msg "Sistema detectado: ${sistema}" "DEBUG"

    if [ "$sistema" = "termux" ]; then
        echo -e "${BYellow}1)${Color_Off} pip install --upgrade yt-dlp ${BGreen}[RECOMENDADO]${Color_Off}"
        echo -e "${BYellow}2)${Color_Off} Instalar/actualizar Node.js (runtime JavaScript)"
        echo -e "${BYellow}3)${Color_Off} Cancelar"
        read -p "Opción: " opcion_update </dev/tty

        case ${opcion_update:-1} in
            1) instalar_ytdlp ;;
            2) instalar_deno ;;
            *) msg "Actualización cancelada" "INFO" ;;
        esac

    elif [ "$sistema" = "gitbash" ]; then
        echo ""
        msg "INSTRUCCIONES PARA WINDOWS (Git Bash):" "INFO"
        echo ""
        msg "1. Abre: ${BCyan}https://github.com/yt-dlp/yt-dlp/releases/latest${Color_Off}" "INFO"
        msg "2. Descarga: ${BYellow}yt-dlp.exe${Color_Off} y reemplaza el antiguo (o ponlo en tu PATH)" "INFO"
        msg "3. Instala Deno desde PowerShell: irm https://deno.land/install.ps1 | iex" "INFO"
        echo ""

    else
        # Ubuntu, WSL (WSL es Linux: NO se usa el .exe), Red Hat y otros Linux
        [ "$sistema" = "wsl" ] && msg "WSL = Linux: se usa el binario de Linux, no el .exe de Windows" "DEBUG"
        echo -e "${BYellow}1)${Color_Off} Instalar binario oficial (curl) ${BGreen}[RECOMENDADO]${Color_Off}"
        echo -e "${BYellow}2)${Color_Off} Instalar/actualizar Deno (runtime JavaScript, necesario para YouTube)"
        echo -e "${BYellow}3)${Color_Off} Todo: yt-dlp + Deno + ffmpeg ${BGreen}[Si algo falla]${Color_Off}"
        echo -e "${BYellow}4)${Color_Off} yt-dlp -U (auto-actualizar, solo binario oficial)"
        echo -e "${BYellow}5)${Color_Off} pip install --upgrade \"yt-dlp[default]\""
        echo -e "${BYellow}6)${Color_Off} Mostrar comandos manuales"
        echo -e "${BYellow}7)${Color_Off} Cancelar"
        read -p "Opción [1]: " opcion_update </dev/tty

        case ${opcion_update:-1} in
            1)
                instalar_ytdlp && { echo ""; verificar_version_ytdlp; }
                ;;
            2)
                instalar_deno
                ;;
            3)
                instalar_ytdlp
                [ "$JS_RUNTIME" = "none" ] && instalar_deno
                command -v ffmpeg >/dev/null 2>&1 || instalar_paquete ffmpeg
                echo ""
                verificar_version_ytdlp
                ;;
            4)
                yt-dlp -U
                hash -r
                ;;
            5)
                msg "Actualizando yt-dlp con pip..." "INFO"
                pip install --upgrade "yt-dlp[default]" --break-system-packages || pip install --user --upgrade "yt-dlp[default]"
                hash -r
                ;;
            6)
                mostrar_comandos_manuales
                ;;
            *)
                msg "Actualización cancelada" "INFO"
                ;;
        esac
    fi

    pause_continue "Proceso de actualización finalizado"
}

