verificar_dependencias() {
    local resp version dias

    # --- yt-dlp ---
    if ! command -v yt-dlp >/dev/null 2>&1; then
        msg "yt-dlp no está instalado." "ERROR"
        read -p "¿Instalarlo ahora? (s/n): " resp </dev/tty
        if [[ "$resp" =~ ^[sS]$ ]]; then
            instalar_ytdlp || exit 1
        else
            exit 1
        fi
    fi

    version=$(yt-dlp --version 2>/dev/null)
    msg "Usando yt-dlp versión: ${version} ($(command -v yt-dlp))" "DEBUG"

    # La copia de apt (/usr/bin) suele estar vieja y YouTube cambia cada pocas semanas
    if [ "$(command -v yt-dlp)" = "/usr/bin/yt-dlp" ] && command -v dpkg >/dev/null 2>&1 && dpkg -S /usr/bin/yt-dlp >/dev/null 2>&1; then
        msg "⚠️ yt-dlp viene de apt, que suele estar desactualizado. Usa el menú 8 para instalar el binario oficial." "WARNING"
    fi

    dias=$(ytdlp_dias_antiguedad "$version")
    if [[ "$dias" =~ ^[0-9]+$ ]] && [ "$dias" -gt 60 ]; then
        msg "⚠️ Tu yt-dlp tiene ${dias} días. Si falla una descarga, actualízalo (menú 8)." "WARNING"
    fi

    # --- ffmpeg ---
    if ! command -v ffmpeg >/dev/null 2>&1; then
        msg "⚠️ ffmpeg no está instalado (necesario para unir video+audio y convertir audio)" "WARNING"
        if [ "$SO_SYSTEM" != "gitbash" ]; then
            read -p "¿Instalar ffmpeg ahora? (s/n): " resp </dev/tty
            if [[ "$resp" =~ ^[sS]$ ]]; then
                instalar_paquete ffmpeg
                hash -r
            fi
        else
            msg "  - Windows/Git Bash: https://ffmpeg.org/download.html" "INFO"
        fi

        if ! command -v ffmpeg >/dev/null 2>&1; then
            read -p "¿Continuar sin ffmpeg? (s/n): " resp </dev/tty
            [[ "$resp" =~ ^[sS]$ ]] || exit 1
        fi
    else
        msg "Usando $(ffmpeg -version 2>/dev/null | head -1)" "DEBUG"
    fi

    # --- Runtime de JavaScript ---
    detectar_js_runtime
    if [ "$JS_RUNTIME" = "none" ]; then
        msg "⚠️ No hay runtime de JavaScript (deno/node). YouTube lo exige: sin él, yt-dlp" "WARNING"
        msg "   solo ve una parte de los formatos y falla con 'Requested format is not available'." "WARNING"
        read -p "¿Instalar Deno ahora? (s/n): " resp </dev/tty
        if [[ "$resp" =~ ^[sS]$ ]]; then
            instalar_deno
        fi
    else
        msg "Runtime JavaScript: ${JS_RUNTIME}" "DEBUG"
    fi
}

verificar_version_ytdlp() {
    echo ""
    msg "╔═══════════════════════════════════════╗" "INFO"
    msg "║   🔍 VERIFICANDO VERSIÓN DE YT-DLP    ║" "INFO"
    msg "╚═══════════════════════════════════════╝" "INFO"
    echo ""

    if ! command -v yt-dlp >/dev/null 2>&1; then
        msg "yt-dlp no está instalado" "ERROR"
        return 1
    fi

    local version_actual ultima_version
    version_actual=$(yt-dlp --version 2>/dev/null)
    msg "Sistema detectado: ${SO_SYSTEM}" "INFO"
    msg "Versión instalada: ${version_actual}  ($(command -v yt-dlp))" "INFO"
    msg "Runtime JavaScript: ${JS_RUNTIME}" "INFO"
    if command -v ffmpeg >/dev/null 2>&1; then
        msg "ffmpeg: instalado" "INFO"
    else
        msg "ffmpeg: NO instalado" "WARNING"
    fi

    echo ""
    msg "Consultando última versión disponible..." "INFO"

    ultima_version=$(curl -fsS --max-time 10 https://api.github.com/repos/yt-dlp/yt-dlp/releases/latest 2>/dev/null \
        | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)

    if [ -z "$ultima_version" ]; then
        msg "No se pudo obtener la última versión desde GitHub" "WARNING"
        msg "Verifica tu conexión a Internet" "WARNING"
        return 1
    fi

    msg "Última versión disponible: ${ultima_version}" "SUCCESS"
    echo ""

    if [ "$version_actual" = "$ultima_version" ]; then
        msg "✅ ¡Tienes la versión más reciente!" "SUCCESS"
    else
        msg "⚠️  Hay una nueva versión disponible" "WARNING"
        msg "   Actual: ${version_actual}" "WARNING"
        msg "   Nueva: ${ultima_version}" "WARNING"
    fi

    return 0
}

