# Devuelve 0 si el error es "fatal" (reintentar no sirve) y 1 si vale la pena reintentar
diagnosticar_error_ytdlp() {
    local log="$1"

    if grep -qi "Requested format is not available" "$log"; then
        msg "❌ YouTube no devolvió formatos utilizables para este video." "ERROR"
        msg "   Causas habituales: yt-dlp desactualizado o falta un runtime de JavaScript." "WARNING"
        msg "   Runtime JS detectado: ${JS_RUNTIME}" "WARNING"
        msg "   → Usa el menú 8 (actualizar yt-dlp / instalar Deno)" "INFO"
        msg "   → Para ver qué formatos hay: yt-dlp -F URL" "INFO"
        return 0
    elif grep -qiE "Sign in to confirm|not a bot" "$log"; then
        msg "❌ YouTube pide verificación (anti-bot)." "ERROR"
        msg "   Exporta tus cookies (formato Netscape) a: ${COOKIES_FILE}" "WARNING"
        msg "   El script las usará automáticamente la próxima vez." "WARNING"
        return 0
    elif grep -qiE "Private video|Video unavailable|members-only|has been removed|confirm your age|age-restricted" "$log"; then
        msg "❌ El video no está disponible (privado, eliminado, con restricción de edad o solo miembros)." "ERROR"
        return 0
    elif grep -qiE "ffmpeg is not installed|ffprobe and ffmpeg not found|ffmpeg not found" "$log"; then
        msg "❌ Falta ffmpeg (necesario para unir video+audio o convertir audio)." "ERROR"
        msg "   Instálalo con: sudo apt install ffmpeg" "INFO"
        return 0
    elif grep -qi "HTTP Error 429" "$log"; then
        msg "⚠️ YouTube está limitando las peticiones (429). Se esperará más antes de reintentar." "WARNING"
        sleep 20
        return 1
    elif grep -qi "HTTP Error 403" "$log"; then
        msg "⚠️ Error 403: normalmente se arregla actualizando yt-dlp (menú 8)." "WARNING"
        return 1
    fi

    return 1
}

# Uso: ejecutar_con_reintentos yt-dlp [args...]   (comando como array, sin eval)
ejecutar_con_reintentos() {
    local max_intentos=3 intento=1 rc fatal log ejs_probado=0
    local -a cmd=("$@")

    log=$(mktemp)

    msg "🔍 Ejecutando comando:" "DEBUG"
    printf '%b%s%b\n\n' "$BPurple" "$(printf '%q ' "${cmd[@]}")" "$Color_Off"

    while [ $intento -le $max_intentos ]; do
        msg "Intento $intento de $max_intentos..." "INFO"

        # </dev/null: evita que yt-dlp/ffmpeg consuman el stdin (rompía la lectura de lotes)
        "${cmd[@]}" </dev/null 2>&1 | tee "$log"
        rc=${PIPESTATUS[0]}

        if [ $rc -eq 0 ]; then
            rm -f "$log"
            msg "Descarga completada exitosamente" "SUCCESS"
            return 0
        fi

        # Si falla la resolución de desafíos JS, reintentar una vez descargando los scripts EJS
        if [ $ejs_probado -eq 0 ] && grep -E "^(ERROR|WARNING)" "$log" | grep -qiE "ejs|challenge|n.?sig"; then
            ejs_probado=1
            cmd=("${cmd[0]}" --remote-components ejs:github "${cmd[@]:1}")
            msg "Reintentando con --remote-components ejs:github ..." "WARNING"
            continue
        fi

        diagnosticar_error_ytdlp "$log"
        fatal=$?
        if [ $fatal -eq 0 ]; then
            rm -f "$log"
            msg "Error: no tiene sentido reintentar. Corrige lo indicado arriba." "ERROR"
            return 1
        fi

        if [ $intento -lt $max_intentos ]; then
            msg "Error en la descarga. Reintentando en 5 segundos..." "WARNING"
            sleep 5
        else
            msg "Error: Se agotaron los intentos de descarga" "ERROR"
        fi
        ((intento++))
    done

    rm -f "$log"
    return 1
}

# Busca el archivo creado por esta descarga (más fiable que el find anterior)
buscar_archivo_descargado() {
    local slug="$1" marker="$2"
    find "$DOWNLOADS_PATH" -maxdepth 1 -type f -newer "$marker" -name "${slug}*" \
        ! -name "*.part" ! -name "*.ytdl" ! -name "*.srt" ! -name "*.vtt" 2>/dev/null | tail -n 1
}

