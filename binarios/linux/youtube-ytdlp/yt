    local solo_audio
    solo_audio=$(extraer_url_video "$url")
    URL_ACTUAL="$solo_audio"

    if verificar_descarga_previa "$solo_audio"; then
        msg "Operación cancelada - Audio ya descargado previamente" "INFO"
        return 0
    fi

    obtener_info_video "$solo_audio" || { pause_continue "No se pudo leer el video"; return 1; }
    mostrar_info_video

    seleccionar_formato_audio

    local slug
    slug=$(slug_titulo_video)

    msg "Iniciando descarga del audio..." "INFO"

    if descargar_audio_core "$solo_audio" "$slug"; then
        if [[ -n "$ARCHIVO_DESCARGADO" ]]; then
            msg "Fichero de audio descargado en: ${ARCHIVO_DESCARGADO}" "SUCCESS"
            guardar_historial "$solo_audio" "$VIDEO_TITULO" "AUDIO"
        else
            msg "Audio descargado pero no se encontró el archivo" "WARNING"
        fi
    else
        pause_continue "La descarga falló"
        return 1
    fi

    pause_continue "Descarga completada"
}

descargar_por_lotes() {
    echo ""
    echo -e "${BCyan}╔═══════════════════════════════════════╗${Color_Off}"
    echo -e "${BCyan}║${Color_Off}  ${BWhite}📦 DESCARGA POR LOTES${Color_Off}              ${BCyan}║${Color_Off}"
    echo -e "${BCyan}╚═══════════════════════════════════════╝${Color_Off}"
    echo ""
    echo -e "${Gray}Crea un archivo de texto con URLs (una por línea)${Color_Off}"
    echo -e "${Gray}Ejemplo de archivo 'urls.txt':${Color_Off}"
    echo -e "${Gray}  https://youtube.com/watch?v=...${Color_Off}"
    echo -e "${Gray}  https://youtube.com/watch?v=...${Color_Off}"
    echo ""
    read -p "Ruta del archivo con URLs: " archivo_urls </dev/tty

    if [[ ! -f "$archivo_urls" ]]; then
        msg "El archivo no existe: $archivo_urls" "ERROR"
        return 1
    fi

    # Contar URLs válidas
    local total_urls=$(grep -v "^#" "$archivo_urls" | grep -v "^$" | grep "^https\?://" | wc -l)

    if [ "$total_urls" -eq 0 ]; then
        msg "No se encontraron URLs válidas en el archivo" "ERROR"
        return 1
    fi

    msg "Se encontraron $total_urls URLs para descargar" "INFO"

    echo ""
    echo -e "${BBlue}¿Qué tipo de contenido deseas descargar?${Color_Off}"
    echo -e "${BYellow}1)${Color_Off} Videos"
    echo -e "${BYellow}2)${Color_Off} Solo audio"
    read -p "Opción [1]: " tipo_descarga </dev/tty

    # Configuración única para todas las descargas
    if [[ "${tipo_descarga:-1}" == "1" ]]; then
        URL_ACTUAL=""
        seleccionar_calidad_video
        configurar_subtitulos
    else
        seleccionar_formato_audio
    fi

    local contador=0
    local exitosos=0
    local fallidos=0

    echo ""
    msg "═══════════════════════════════════════" "INFO"
    msg "Iniciando descarga por lotes..." "INFO"
    msg "═══════════════════════════════════════" "INFO"

    # Leer archivo usando redirección de archivo para evitar conflictos
    while IFS= read -r url || [ -n "$url" ]; do
        # Saltar líneas vacías y comentarios
        [[ -z "$url" ]] && continue
        [[ "$url" =~ ^[[:space:]]*# ]] && continue
        [[ ! "$url" =~ ^https?:// ]] && continue

        # Limpiar espacios
        url=$(echo "$url" | tr -d '[:space:]')

        ((contador++))
        echo ""
        msg "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" "INFO"
        msg "📥 Procesando URL $contador de $total_urls" "INFO"
        msg "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" "INFO"
        echo -e "${Gray}URL: ${url}${Color_Off}"

        # Usar funciones batch que no tienen interacciones
        if [[ "${tipo_descarga:-1}" == "1" ]]; then
            if descargar_video_batch "$url"; then
                ((exitosos++))
            else
                ((fallidos++))
                msg "✗ Error al descargar video #$contador" "ERROR"
            fi
        else
            if descargar_audio_batch "$url"; then
                ((exitosos++))
            else
                ((fallidos++))
                msg "✗ Error al descargar audio #$contador" "ERROR"
            fi
        fi

    done < "$archivo_urls"

    echo ""
    msg "═══════════════════════════════════════" "SUCCESS"
    msg "RESUMEN DE DESCARGA POR LOTES" "SUCCESS"
    msg "═══════════════════════════════════════" "SUCCESS"
    msg "Total procesadas: $total_urls" "INFO"
    msg "Exitosas: $exitosos" "SUCCESS"
    msg "Fallidas: $fallidos" "ERROR"

    if [ $exitosos -eq $total_urls ]; then
        msg "🎉 ¡Todas las descargas se completaron exitosamente!" "SUCCESS"
    elif [ $exitosos -gt 0 ]; then
        msg "⚠️  Se completaron $exitosos de $total_urls descargas" "WARNING"
    else
        msg "❌ No se pudo completar ninguna descarga" "ERROR"
    fi

    pause_continue "Descarga por lotes completada"
}

ver_historial() {
    echo ""
    echo -e "${BCyan}╔═══════════════════════════════════════╗${Color_Off}"
    echo -e "${BCyan}║${Color_Off}  ${BWhite}📊 HISTORIAL DE DESCARGAS${Color_Off}          ${BCyan}║${Color_Off}"
    echo -e "${BCyan}╚═══════════════════════════════════════╝${Color_Off}"
    echo ""

    if [[ ! -f "$HISTORIAL_FILE" ]]; then
        msg "No hay historial de descargas" "WARNING"
        return 0
    fi

    local total_lineas=$(wc -l < "$HISTORIAL_FILE" 2>/dev/null || echo 0)

    if [ "$total_lineas" -eq 0 ]; then
        msg "El historial está vacío" "WARNING"
        return 0
    fi

    msg "Total de descargas: $total_lineas" "INFO"
    echo ""

    echo -e "${Gray}Últimas 10 descargas:${Color_Off}"
    echo -e "${Gray}────────────────────────────────────────${Color_Off}"

    tail -n 10 "$HISTORIAL_FILE" | while IFS='|' read -r fecha tipo titulo url; do
        echo -e "${BYellow}[$tipo]${Color_Off} ${fecha}"
        echo -e "  ${Gray}${titulo}${Color_Off}"
        echo ""
    done

    echo ""
    read -p "¿Deseas ver el historial completo? (s/n): " ver_completo </dev/tty

    if [[ "$ver_completo" =~ ^[sS]$ ]]; then
        if command -v less &> /dev/null; then
            less "$HISTORIAL_FILE"
        else
            cat "$HISTORIAL_FILE"
        fi
    fi
}


