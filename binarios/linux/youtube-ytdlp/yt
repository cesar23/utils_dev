limpiar_na() {
    [ "$1" = "NA" ] && echo "" || echo "$1"
}

# Una sola llamada a yt-dlp (antes eran 2) -> rellena las variables VIDEO_*
obtener_info_video() {
    local url="$1" errlog salida
    local -a l

    VIDEO_TITULO=""; VIDEO_AUTOR=""; VIDEO_DURACION=""; VIDEO_TAMANO=""; VIDEO_ID=""
    msg "Obteniendo información del video..." "INFO"

    errlog=$(mktemp)
    # --ignore-no-formats-error: muestra los datos aunque el selector de formatos falle
    salida=$(yt-dlp "${YTDLP_COMMON[@]}" --no-playlist --skip-download --ignore-no-formats-error --no-warnings \
        --print "%(title)s" --print "%(uploader)s" --print "%(duration_string)s" \
        --print "%(filesize_approx)s" --print "%(id)s" "$1" 2>"$errlog")
    mapfile -t l <<< "$salida"

    VIDEO_TITULO=$(limpiar_na "${l[0]}")
    VIDEO_AUTOR=$(limpiar_na "${l[1]}")
    VIDEO_DURACION=$(limpiar_na "${l[2]}")
    local bytes
    bytes=$(limpiar_na "${l[3]}")
    VIDEO_ID=$(limpiar_na "${l[4]}")

    if [[ "$bytes" =~ ^[0-9]+$ ]] && [ "$bytes" -gt 0 ]; then
        VIDEO_TAMANO="$((bytes / 1024 / 1024))MB"
    else
        VIDEO_TAMANO="Desconocido"
    fi

    if [ -z "$VIDEO_ID" ] && [ -z "$VIDEO_TITULO" ]; then
        msg "No se pudo obtener información del video" "ERROR"
        grep -E "ERROR" "$errlog" | tail -n 3 | while IFS= read -r linea; do
            msg "  ${linea}" "WARNING"
        done
        rm -f "$errlog"
        return 1
    fi

    rm -f "$errlog"
    [ -z "$VIDEO_TITULO" ] && VIDEO_TITULO="video-${VIDEO_ID}"
    return 0
}

