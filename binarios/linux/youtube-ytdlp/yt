# Días desde la fecha de la versión (yt-dlp usa AAAA.MM.DD)
ytdlp_dias_antiguedad() {
    local v ts_v ts_now
    v=$(echo "$1" | cut -d. -f1-3 | tr . -)
    ts_v=$(date -d "$v" +%s 2>/dev/null) || return 1
    ts_now=$(date +%s)
    echo $(( (ts_now - ts_v) / 86400 ))
}

instalar_ytdlp() {
    if [ "$SO_SYSTEM" = "termux" ]; then
        msg "Instalando yt-dlp con pip (Termux)..." "INFO"
        pip install --upgrade "yt-dlp[default]" && hash -r
        return $?
    fi

    if [ "$SO_SYSTEM" = "gitbash" ]; then
        msg "En Git Bash descarga yt-dlp.exe: https://github.com/yt-dlp/yt-dlp/releases/latest" "INFO"
        return 1
    fi

    # Linux / Ubuntu / WSL: binario oficial (el de apt suele estar muy desactualizado)
    local destino="/usr/local/bin/yt-dlp" tmp
    if ! command -v python3 >/dev/null 2>&1; then
        msg "El binario oficial de yt-dlp necesita python3. Instalándolo..." "INFO"
        instalar_paquete python3 || return 1
    fi

    tmp=$(mktemp)
    msg "Descargando yt-dlp (binario oficial)..." "INFO"
    if curl -fL --progress-bar -o "$tmp" "https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp" \
        && ejecutar_root install -m 755 "$tmp" "$destino"; then
        rm -f "$tmp"
        hash -r
        msg "✓ yt-dlp instalado en ${destino}: $(yt-dlp --version 2>/dev/null)" "SUCCESS"
        local activo
        activo=$(command -v yt-dlp)
        if [ "$activo" != "$destino" ]; then
            msg "⚠️ Tu PATH usa otra copia: ${activo}" "WARNING"
            msg "   Elimínala (ej: sudo apt remove yt-dlp) para usar la versión nueva" "WARNING"
        fi
        return 0
    fi

    rm -f "$tmp"
    msg "Error al instalar yt-dlp" "ERROR"
    return 1
}
string_slugify() {
    local input="$1"
    local case="$2"

    [[ -z "$input" ]] && echo "" && return

    input="$(echo "$input" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"

    case "$case" in
        lower)
            input="$(echo "$input" | tr '[:upper:]' '[:lower:]')"
            ;;
        upper)
            input="$(echo "$input" | tr '[:lower:]' '[:upper:]')"
            ;;
        capitalize)
            first="$(echo "${input:0:1}" | tr '[:lower:]' '[:upper:]')"
            rest="$(echo "${input:1}" | tr '[:upper:]' '[:lower:]')"
            input="$first$rest"
            ;;
        title)
            input="$(echo "$input" | awk '{for(i=1;i<=NF;i++){ $i=toupper(substr($i,1,1)) tolower(substr($i,2)) }}1')"
            ;;
        none|"")
            ;;
        *)
            echo "Error: parámetro inválido. Usa: lower, upper, capitalize, title o none."
            return 1
            ;;
    esac

    input="$(echo "$input" | sed 's/[^[:alnum:] _-]//g')"
    input="$(echo "$input" | sed -E 's/[[:space:]_]+/-/g')"
    input="$(echo "$input" | sed -E 's/^-+|-+$//g')"

    echo "$input"
}

