    URL_ACTUAL=""

    msg "Preparando descarga de playlist..." "INFO"

    seleccionar_calidad_video
    configurar_subtitulos

    msg "Iniciando descarga de playlist..." "INFO"
    args_ruta

    local -a cmd=(yt-dlp "${YTDLP_COMMON[@]}" -c --no-mtime
        -f "$FORMATO_VIDEO" "${SUBTITULOS_ARGS[@]}"
        --merge-output-format "$FORMATO_CONTENEDOR"
        --yes-playlist "${ARGS_RUTA[@]}" --progress --newline
        -o "${DOWNLOADS_PATH}/%(playlist_index)02d-%(title)s.%(ext)s" "$url")

    if ejecutar_con_reintentos "${cmd[@]}"; then
        msg "Playlist descargado exitosamente" "SUCCESS"
        guardar_historial "$url" "PLAYLIST" "PLAYLIST"
    else
        pause_continue "La descarga de la playlist falló"
        return 1
    fi

    echo ""
    read -p "¿Deseas renombrar los archivos descargados a formato slug? (s/n): " resp </dev/tty
    if [[ "$resp" =~ ^[sS]$ ]]; then
        msg "Renombrando archivos a formato slug..." "INFO"
        local count=0 archivo nombre extension base slug nuevo
        for archivo in "${DOWNLOADS_PATH}"/*.{mp4,mkv,webm,flv}; do
            [ -e "$archivo" ] || continue
            nombre=$(basename "$archivo")
            extension="${nombre##*.}"
            base="${nombre%.*}"
            slug=$(string_slugify "$base" title)
            nuevo="${DOWNLOADS_PATH}/${slug}.${extension}"
            if [[ "$archivo" != "$nuevo" ]]; then
                echo "Renombrando: $nombre -> ${slug}.${extension}"
                mv "$archivo" "$nuevo"
                ((count++))
            fi
        done
        if [ $count -gt 0 ]; then
            msg "Renombrado completado: $count archivo(s)" "SUCCESS"
        else
            msg "No se encontraron archivos para renombrar" "WARNING"
        fi
    fi

    pause_continue "Descarga de playlist completada"
}

