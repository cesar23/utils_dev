# Núcleo común de video (interactivo y lotes): URL + nombre base sin extensión
descargar_video_core() {
    local url="$1" slug="$2" marker rc=1
    marker=$(mktemp "${CONFIG_DIR}/marker.XXXXXX")
    args_ruta

    local -a cmd=(yt-dlp "${YTDLP_COMMON[@]}" --no-playlist -c --no-mtime
        -f "$FORMATO_VIDEO" "${SUBTITULOS_ARGS[@]}"
        --merge-output-format "$FORMATO_CONTENEDOR"
        "${ARGS_RUTA[@]}" --progress --newline
        -o "${DOWNLOADS_PATH}/${slug}.%(ext)s" "$url")

    if ejecutar_con_reintentos "${cmd[@]}"; then
        ARCHIVO_DESCARGADO=$(buscar_archivo_descargado "$slug" "$marker")
