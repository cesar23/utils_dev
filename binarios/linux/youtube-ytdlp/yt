# Selector de formato moderno: YouTube casi no ofrece archivos "video+audio" ya unidos,
# así que se piden pistas separadas y ffmpeg las une. Se prefiere H.264 + AAC (avc1/m4a)
# porque es lo que aceptan sin problemas Premiere, Windows y móviles.
formato_mp4() {
    local h="$1" hf=""
    [ -n "$h" ] && hf="[height<=${h}]"
    echo "bv*${hf}[vcodec^=avc1]+ba[ext=m4a]/bv*${hf}[ext=mp4]+ba[ext=m4a]/bv*${hf}+ba/b${hf}/b"
}

seleccionar_calidad_video() {
    echo ""
    echo -e "${BBlue}Selecciona la calidad y formato de descarga:${Color_Off}"
    echo -e "${BYellow}1)${Color_Off} Mejor calidad MP4 (H.264+AAC, compatible con Premiere) ${BGreen}[RECOMENDADO]${Color_Off}"
    echo -e "${BYellow}2)${Color_Off} Hasta 1080p MP4"
    echo -e "${BYellow}3)${Color_Off} Hasta 720p MP4"
    echo -e "${BYellow}4)${Color_Off} Hasta 480p MP4"
    echo -e "${BYellow}5)${Color_Off} Hasta 360p MP4"
    echo -e "${BYellow}6)${Color_Off} Mejor calidad absoluta MKV (puede ser VP9/AV1)"
    echo -e "${BYellow}7)${Color_Off} Personalizado (elegir formato de la lista) ${Gray}[Avanzado]${Color_Off}"
    read -p "Opción [1]: " calidad_opcion </dev/tty

    FORMATO_CONTENEDOR="mp4"
    case ${calidad_opcion:-1} in
        1) FORMATO_VIDEO=$(formato_mp4 "");     msg "Formato: Mejor calidad MP4" "DEBUG" ;;
        2) FORMATO_VIDEO=$(formato_mp4 1080);   msg "Formato: hasta 1080p MP4" "DEBUG" ;;
        3) FORMATO_VIDEO=$(formato_mp4 720);    msg "Formato: hasta 720p MP4" "DEBUG" ;;
        4) FORMATO_VIDEO=$(formato_mp4 480);    msg "Formato: hasta 480p MP4" "DEBUG" ;;
        5) FORMATO_VIDEO=$(formato_mp4 360);    msg "Formato: hasta 360p MP4" "DEBUG" ;;
        6)
            FORMATO_VIDEO="bv*+ba/b"
            FORMATO_CONTENEDOR="mkv"
            msg "Formato: Mejor calidad MKV" "DEBUG"
            ;;
        7)
            if [ -n "$URL_ACTUAL" ]; then
                msg "Formatos disponibles:" "INFO"
                yt-dlp "${YTDLP_COMMON[@]}" --no-playlist -F "$URL_ACTUAL" </dev/null
            fi
            echo -e "${Gray}Ejemplos: 137+140  |  bv*[height<=1080]+ba  |  18${Color_Off}"
            read -p "Código/selector de formato [bv*+ba/b]: " FORMATO_VIDEO </dev/tty
            FORMATO_VIDEO="${FORMATO_VIDEO:-bv*+ba/b}"
            read -p "Contenedor de salida (mp4/mkv/webm) [mkv]: " FORMATO_CONTENEDOR </dev/tty
            FORMATO_CONTENEDOR="${FORMATO_CONTENEDOR:-mkv}"
            msg "Formato personalizado: ${FORMATO_VIDEO} → ${FORMATO_CONTENEDOR}" "WARNING"
            ;;
        *) FORMATO_VIDEO=$(formato_mp4 "") ;;
    esac
}

