# Devuelve: termux | wsl | gitbash | ubuntu | redhat | unknown
# Mejoras: detecta WSL1 y WSL2 (el kernel de WSL2 dice "microsoft" en minúscula),
# no contamina el entorno al leer /etc/os-release y reconoce derivados
# (Linux Mint, Pop!_OS, Kali... vía ID_LIKE).
detect_system() {
    if [ -f /data/data/com.termux/files/usr/bin/pkg ]; then
        echo "termux"
    elif [ -n "$WSL_DISTRO_NAME" ] || [ -n "$WSL_INTEROP" ] || grep -qiE "microsoft|wsl" /proc/version 2>/dev/null; then
        echo "wsl"
    elif [ -n "$MSYSTEM" ]; then
        echo "gitbash"
    elif [ -f /etc/os-release ]; then
        local ids
        ids=$( . /etc/os-release; echo "${ID} ${ID_LIKE}" )
        case "$ids" in
            *ubuntu*|*debian*)
                echo "ubuntu"
                ;;
            *rhel*|*centos*|*fedora*|*rocky*|*almalinux*)
                echo "redhat"
                ;;
            *)
                echo "unknown"
                ;;
        esac
    else
        echo "unknown"
    fi
}

# ¿Es un Linux "de verdad" (incluye WSL, que es Linux y NO debe usar el .exe)?
es_linux() {
    case "$SO_SYSTEM" in
        ubuntu|wsl|redhat|unknown) return 0 ;;
        *) return 1 ;;
    esac
}

# Define cómo elevar privilegios: root -> nada, con sudo -> "sudo", sin ninguno -> marca
init_sudo() {
    if [ "$(id -u)" -eq 0 ] || [ "$SO_SYSTEM" = "termux" ]; then
        SUDO=""
    elif command -v sudo >/dev/null 2>&1; then
        SUDO="sudo"
    else
        SUDO="__none__"
    fi
}

ejecutar_root() {
    if [ "$SUDO" = "__none__" ]; then
        msg "Se necesitan privilegios de administrador y 'sudo' no está disponible" "ERROR"
        return 1
    elif [ -n "$SUDO" ]; then
        sudo "$@"
    else
        "$@"
    fi
}

instalar_paquete() {
    local paquete="$1"
    if [ "$SO_SYSTEM" = "termux" ]; then
        pkg install -y "$paquete"
    elif command -v apt-get >/dev/null 2>&1; then
        ejecutar_root apt-get update -qq && ejecutar_root apt-get install -y "$paquete"
    elif command -v dnf >/dev/null 2>&1; then
        ejecutar_root dnf install -y "$paquete"
    elif command -v yum >/dev/null 2>&1; then
        ejecutar_root yum install -y "$paquete"
    else
        msg "No se detectó un gestor de paquetes compatible para instalar '$paquete'" "ERROR"
        return 1
    fi
}

# Carpeta de descargas por defecto según el sistema
ruta_descargas_defecto() {
    local ruta=""
    case "$SO_SYSTEM" in
        termux)
            ruta="/storage/emulated/0/Download/youtube"
            ;;
        wsl)
            # Intentar usar la carpeta Descargas de Windows (accesible desde el explorador)
            if command -v cmd.exe >/dev/null 2>&1 && command -v wslpath >/dev/null 2>&1; then
                local win_profile win_path
                win_profile=$(cd /mnt/c 2>/dev/null && cmd.exe /c "echo %USERPROFILE%" 2>/dev/null | tr -d '\r' | tail -n 1)
                if [ -n "$win_profile" ]; then
                    win_path=$(wslpath -u "$win_profile" 2>/dev/null)
                    [ -d "${win_path}/Downloads" ] && ruta="${win_path}/Downloads/youtube"
                fi
            fi
            ;;
        *)
            if command -v xdg-user-dir >/dev/null 2>&1; then
                local d
                d=$(xdg-user-dir DOWNLOAD 2>/dev/null)
                [ -n "$d" ] && [ "$d" != "$CURRENT_USER_HOME" ] && [ -d "$d" ] && ruta="${d}/youtube"
            fi
            ;;
    esac
    echo "${ruta:-${CURRENT_USER_HOME}/Downloads/youtube}"
}

# -----------------------------------------------------------------------------
# JavaScript runtime (YouTube exige resolver desafíos JS; yt-dlp usa deno por defecto)
# -----------------------------------------------------------------------------

detectar_js_runtime() {
    JS_RUNTIME="none"
    JS_RUNTIME_ARGS=()

    # Deno instalado por su script oficial vive en ~/.deno/bin (a veces fuera del PATH)
    if ! command -v deno >/dev/null 2>&1 && [ -x "${CURRENT_USER_HOME}/.deno/bin/deno" ]; then
        export PATH="${CURRENT_USER_HOME}/.deno/bin:${PATH}"
    fi

    if command -v deno >/dev/null 2>&1; then
        JS_RUNTIME="deno"                      # yt-dlp lo usa por defecto
    elif command -v node >/dev/null 2>&1; then
        local major
        major=$(node -v 2>/dev/null | sed 's/^v//; s/\..*//')
        if [[ "$major" =~ ^[0-9]+$ ]] && [ "$major" -ge 20 ]; then
            JS_RUNTIME="node"
            JS_RUNTIME_ARGS=(--js-runtimes node)
        fi
    fi

    if [ "$JS_RUNTIME" = "none" ]; then
        local q
        for q in qjs quickjs; do
            if command -v "$q" >/dev/null 2>&1; then
                JS_RUNTIME="quickjs"
                JS_RUNTIME_ARGS=(--js-runtimes quickjs)
                break
            fi
        done
    fi
}

instalar_deno() {
    if [ "$SO_SYSTEM" = "termux" ]; then
        msg "En Termux se usa Node.js como runtime JavaScript" "INFO"
        instalar_paquete nodejs && detectar_js_runtime
        return $?
    fi

    if [ "$SO_SYSTEM" = "gitbash" ]; then
        msg "En Git Bash instala Deno desde PowerShell: irm https://deno.land/install.ps1 | iex" "INFO"
        return 1
    fi

    if ! command -v curl >/dev/null 2>&1; then
        msg "Se necesita curl para instalar Deno" "ERROR"
        return 1
    fi

    if ! command -v unzip >/dev/null 2>&1; then
        msg "Deno necesita 'unzip'. Instalándolo..." "INFO"
        instalar_paquete unzip || return 1
    fi

    msg "Instalando Deno en ~/.deno/bin (no requiere sudo)..." "INFO"
    if curl -fsSL https://deno.land/install.sh | sh -s -- -y; then
        export PATH="${CURRENT_USER_HOME}/.deno/bin:${PATH}"
        hash -r
        detectar_js_runtime
        if [ "$JS_RUNTIME" = "deno" ]; then
            msg "✓ Deno instalado: $(deno --version 2>/dev/null | head -1)" "SUCCESS"
            preparar_args_ytdlp
            return 0
        fi
    fi

    msg "No se pudo instalar Deno automáticamente" "ERROR"
    msg "Alternativa: instala Node.js 20+ (el script lo usará automáticamente)" "INFO"
    return 1
}

# Argumentos comunes a todas las llamadas a yt-dlp
preparar_args_ytdlp() {
    YTDLP_COMMON=("${JS_RUNTIME_ARGS[@]}")
    # Cookies opcionales (útil si YouTube pide "confirma que no eres un bot")
    if [ -s "$COOKIES_FILE" ]; then
        YTDLP_COMMON+=(--cookies "$COOKIES_FILE")
    fi
}

